# AI Orchestrator — environment template
# Copy to `.env` and fill in real values. NEVER commit the real .env.

# Your Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model used by every agent in the pipeline.
# Default is the latest Opus. Override with claude-sonnet-5 / claude-haiku-4-5 if desired.
ORCHESTRATOR_MODEL=claude-opus-5

# Effort level for the agents: low | medium | high | xhigh | max
ORCHESTRATOR_EFFORT=high

# Where the orchestrator writes generated code / artifacts.
WORKSPACE_DIR=./workspace

# Max Plan->Code->Deploy->Test->Fix iterations before giving up.
MAX_ITERATIONS=5
